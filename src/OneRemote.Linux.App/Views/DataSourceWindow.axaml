<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OneRemote.Linux.App.Views.DataSourceWindow"
        Title="MySQL / PostgreSQL 云端同步与加密设置"
        Width="600" Height="640"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer Padding="18">
    <StackPanel Spacing="10">
      <TextBlock Text="已接入的数据源" FontSize="14" Foreground="#F8FAFC" />
      <ListBox x:Name="SourcesList" Height="110" Background="#0F172A" SelectionChanged="OnSourceSelected" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="subtle" Content="导入 Windows 1Remote 的 AdditionalDataSource.json" Click="OnImportJsonClick" />
        <Button Classes="subtle" Content="移除选中远程源" Click="OnRemoveSelectedSourceClick" Foreground="#FCA5A5" />
      </StackPanel>

      <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,6,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="添加或更新 MySQL / PostgreSQL 同步库（与 Shermanxwz/1Remote v1.3.2 实时互通）" FontSize="13" Foreground="#93C5FD" />

          <Grid ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="数据源名称" FontSize="12" Foreground="#94A3B8" />
              <TextBox x:Name="SourceNameBox" Text="MySQL" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="数据库类型" FontSize="12" Foreground="#94A3B8" />
              <ComboBox x:Name="DbTypeCombo" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,12,110">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="数据库主机 / IP" FontSize="12" Foreground="#94A3B8" />
              <TextBox x:Name="HostBox" Text="127.0.0.1" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="端口" FontSize="12" Foreground="#94A3B8" />
              <TextBox x:Name="PortBox" Text="3306" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="数据库名" FontSize="12" Foreground="#94A3B8" />
              <TextBox x:Name="DbNameBox" Text="1remote" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="用户名" FontSize="12" Foreground="#94A3B8" />
              <TextBox x:Name="UserBox" Text="root" />
            </StackPanel>
            <StackPanel Grid.Column="4" Spacing="4">
              <TextBlock Text="密码" FontSize="12" Foreground="#94A3B8" />
              <TextBox x:Name="PasswordBox" PasswordChar="•" />
            </StackPanel>
          </Grid>

          <TextBlock Text="1Remote 加密盐值 (默认与 Shermanxwz/1Remote v1.3.2 完全一致，一般无需修改)" FontSize="11.5" Foreground="#94A3B8" />
          <TextBox x:Name="SaltBox" />

          <TextBlock x:Name="StatusLabel" FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="subtle" Content="测试连接" Click="OnTestConnectionClick" />
            <Button Classes="accent" Content="保存并同步" Click="OnSaveSourceClick" />
            <Button Classes="subtle" Content="关闭" Click="OnCloseClick" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
