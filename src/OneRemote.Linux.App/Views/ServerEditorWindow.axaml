<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OneRemote.Linux.App.Views.ServerEditorWindow"
        Title="新建 / 编辑远程设备"
        Width="540" Height="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer Padding="18">
    <StackPanel Spacing="10">
      <TextBlock Text="目标数据源（选择 MySQL 可实时同步至 Windows 端 1Remote）" FontSize="12" Foreground="#94A3B8" />
      <ComboBox x:Name="SourceCombo" HorizontalAlignment="Stretch" />

      <TextBlock Text="连接协议" FontSize="12" Foreground="#94A3B8" />
      <ComboBox x:Name="ProtocolCombo" HorizontalAlignment="Stretch" SelectionChanged="OnProtocolSelectionChanged" />

      <TextBlock Text="显示名称" FontSize="12" Foreground="#94A3B8" />
      <TextBox x:Name="DisplayNameBox" Watermark="例如：绿云新加坡 / Windows x" />

      <Grid ColumnDefinitions="*,12,110">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="主机地址 / IP" FontSize="12" Foreground="#94A3B8" />
          <TextBox x:Name="AddressBox" Watermark="198.51.100.10" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="端口" FontSize="12" Foreground="#94A3B8" />
          <TextBox x:Name="PortBox" Text="22" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,12,*">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="用户名" FontSize="12" Foreground="#94A3B8" />
          <TextBox x:Name="UserBox" Text="root" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="密码" FontSize="12" Foreground="#94A3B8" />
          <TextBox x:Name="PasswordBox" PasswordChar="•" />
        </StackPanel>
      </Grid>

      <StackPanel x:Name="SshPanel" Spacing="6">
        <TextBlock Text="SSH 私钥路径（可选，如 ~/.ssh/id_ed25519）" FontSize="12" Foreground="#94A3B8" />
        <Grid ColumnDefinitions="*,8,Auto">
          <TextBox Grid.Column="0" x:Name="PrivateKeyBox" Watermark="~/.ssh/id_ed25519" />
          <Button Grid.Column="2" Classes="subtle" Content="浏览..." Click="OnBrowseKeyClick" />
        </Grid>
        <TextBlock Text="连接后自动执行命令（可选）" FontSize="12" Foreground="#94A3B8" />
        <TextBox x:Name="StartupCmdBox" Watermark="例如：tmux attach || tmux" />
        <CheckBox x:Name="OpenSftpCheck" Content="SSH 连接成功后同时打开 SFTP 标签页" />
      </StackPanel>

      <StackPanel x:Name="RdpPanel" Spacing="6" IsVisible="False">
        <TextBlock Text="Windows 域 (Domain，可选)" FontSize="12" Foreground="#94A3B8" />
        <TextBox x:Name="DomainBox" />
        <CheckBox x:Name="RdpClipboardCheck" Content="启用双向剪贴板同步 (+clipboard)" IsChecked="True" />
        <CheckBox x:Name="RdpFullScreenCheck" Content="全屏启动 (/f；不勾选则启用窗口动态分辨率 /dynamic-resolution)" />
        <CheckBox x:Name="RdpDriveCheck" Content="挂载本地 Ubuntu 主目录到远程 Windows" />
      </StackPanel>

      <TextBlock Text="分组标签（多个标签用英文逗号分隔）" FontSize="12" Foreground="#94A3B8" />
      <TextBox x:Name="TagsBox" Watermark="VPS, 新加坡, 生产环境" />

      <TextBlock Text="备注" FontSize="12" Foreground="#94A3B8" />
      <TextBox x:Name="NoteBox" />

      <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
        <Button Classes="subtle" Content="取消" Click="OnCancelClick" />
        <Button Classes="accent" Content="保存设备" Click="OnSaveClick" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
